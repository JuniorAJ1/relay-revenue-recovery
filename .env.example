# Demo data and simulated delivery; set false for a fresh real workspace.
DEMO_MODE=true
DATABASE_PATH=instance/relay.sqlite3
SECRET_KEY=replace-with-a-long-random-secret-before-live-use
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:8766
# Only enable behind HTTPS with reviewed leads and a monitored worker.
LIVE_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Read-only contact import. Keys are never sent to the browser.
CLOSE_API_KEY=
HIGHLEVEL_TOKEN=
HIGHLEVEL_LOCATION_ID=
